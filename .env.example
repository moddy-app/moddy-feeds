# ─── moddy-feeds — variables d'environnement ───────────────────────────────
# Copier en `.env` pour le développement local (jamais commité).

# PostgreSQL DÉDIÉE au service (targets + state interne).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/moddy_feeds

# Redis PARTAGÉ avec le bot (feeds:commands, feeds:replies, notifications:queue).
REDIS_URL=redis://localhost:6379/0

# YouTube : uniquement la résolution @handle → channel_id (1 unité de quota/abonnement).
# Optionnel : sans clé, fallback scraping HTML (gratuit mais fragile).
YOUTUBE_API_KEY=

# Twitch : app créée sur dev.twitch.tv/console (client credentials).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ─── Temps réel (optionnel) — sans ces variables, tout reste en polling ────
#
# Twitch EventSub WebSocket : live détecté en ~2 s au lieu de ~15 s.
# Le transport websocket impose un *user* access token (le token applicatif
# ci-dessus ne suffit pas). À obtenir UNE fois, avec le compte propriétaire :
#   1. ouvrir https://id.twitch.tv/oauth2/authorize?client_id=<ID>
#        &redirect_uri=http://localhost&response_type=code&scope=
#      (aucun scope nécessaire pour stream.online)
#   2. récupérer le `code=` dans l'URL de redirection
#   3. POST https://id.twitch.tv/oauth2/token avec
#      client_id, client_secret, code, grant_type=authorization_code,
#      redirect_uri=http://localhost
#   4. coller le `refresh_token` obtenu ci-dessous
# Il tourne ensuite tout seul (le nouveau est persisté en Redis).
# Plafond : 300 chaînes couvertes ; au-delà, le reste reste en polling.
TWITCH_USER_REFRESH_TOKEN=
# EVENTSUB_ENABLED=true

# WebSub YouTube : vidéo poussée en ~10 s au lieu de ~1-2 min.
# ⚠️ C'est la SEULE fonctionnalité qui ouvre un port HTTP (cf.
# docs/architecture.md). Nécessite un domaine public — sur Railway, activer
# « Generate Domain » sur le service et recopier l'URL ici.
# WEBSUB_CALLBACK_URL=https://<service>.up.railway.app/websub/youtube
# WEBSUB_SECRET=            # secret HMAC, ex: openssl rand -hex 32
# WEBSUB_LEASE_SECONDS=432000

# ─── Réglages optionnels (valeurs par défaut sûres) ────────────────────────
# LOG_LEVEL=INFO
# LOG_FORMAT=json          # console | json (auto: console en TTY, json sinon/Railway)
# SCHEDULER_TICK_SECONDS=2
# SCHEDULER_BATCH_LIMIT=500     # taille d'un lot de cibles réservées
# SCHEDULER_MAX_BATCHES=20      # lots max drainés par tick
# POLL_CONCURRENCY=50           # polls HTTP simultanés
# DB_POOL_MAX=20
# HEARTBEAT_SECONDS=30
# BLUESKY_ENABLED=true
# INSTAGRAM_ENABLED=false
